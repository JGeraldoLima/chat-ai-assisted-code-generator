{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run conformance:*)",
      "Bash(npm run test:harness:*)",
      "Bash(node harness/regen.mjs:*)",
      "Bash(node e2e/runner.mjs:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-boundary.mjs"
          }
        ]
      }
    ]
  }
}
