{
  "name": "chat-ai-assisted-code-generator",
  "private": true,
  "description": "Chat Generator: spec-driven client generator (harness + spec + e2e). server/, webclient/ and client/ live in this repo.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "npm --prefix server ci --no-audit --no-fund",
    "server": "npm --prefix server start",
    "test:server": "npm --prefix server test",
    "conformance": "node --test \"conformance/*.test.mjs\"",
    "regen": "node harness/regen.mjs",
    "e2e": "node e2e/runner.mjs",
    "test:harness": "node --test \"harness/test/*.test.mjs\""
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "playwright": "1.64.1",
    "yaml": "2.9.1"
  }
}
