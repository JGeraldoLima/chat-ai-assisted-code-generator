{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chatgen.local/schemas/message.schema.json",
  "title": "Stored message (server responses)",
  "type": "object",
  "required": ["id", "seq", "kind", "from", "to", "body", "createdAt", "receivedAt"],
  "properties": {
    "id": { "$ref": "defs.schema.json#/$defs/uuid" },
    "seq": { "type": "integer", "minimum": 1 },
    "kind": { "$ref": "defs.schema.json#/$defs/kind" },
    "from": { "$ref": "defs.schema.json#/$defs/name" },
    "to": { "$ref": "defs.schema.json#/$defs/name" },
    "body": { "$ref": "defs.schema.json#/$defs/body" },
    "createdAt": { "$ref": "defs.schema.json#/$defs/timestamp" },
    "receivedAt": { "$ref": "defs.schema.json#/$defs/timestamp" }
  },
  "additionalProperties": true
}
